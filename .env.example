FLASK_APP=apps.app:create_app("local")
FLASK_ENV=development

FLASK_DEBUG=1

MAIL_SERVER=smtp.naver.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USERNAME=EMAIL
MAIL_PASSWORD=EMAIL_PASSWORD

DISCORD_WEBHOOK_URL=YOUR_DISCORD_URL

FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
FLASK_RUN_EXTRA_ARGS=--with-threads

SMTP_SENDER_EMAIL=YOUR_GMAIL_EMAIL
SMTP_SENDER_PASSWORD=YOUR_GMAIL_SMTP_PASSWORD